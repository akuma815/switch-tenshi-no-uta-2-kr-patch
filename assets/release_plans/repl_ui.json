 },
 {
  "file": "L10N/en/Ogix/Data/DT/Game_2/DT_Game2_GameInfo.uexp",
  "offset": 126,
  "old_encoding": "ascii",
  "old_length_field": 19,
  "old_text": "Released 3/26/1993",
  "new_text": "1993년 3월 26일 발매"
 },
 {
  "file": "L10N/en/Ogix/Data/DT/Game_2/DT_Game2_GameInfo.uexp",
  "offset": 149,
  "old_encoding": "utf16",
  "old_length_field": -441,
  "old_text": "A battle against the dark forces begins once more on the Overworld in another dimension—a century after the previous game.\nThe destinies of Fate, a demon hunter, and his partner Sion, take a drastic turn when they meet a girl named Liana in the Inferno Tower...\nThis game was released in 1993 as a sequel to the first game.Cael, the previous game's hero, makes an appearance in this sequel full of excitement.\nYou won't want to put it down.",
  "new_text": "전작으로부터 100년 후, 또 다른 차원의 오버월드에서\n어둠의 세력과의 싸움이 다시 시작됩니다.\n마물 사냥꾼 페이트와 그의 파트너 시온은 인페르노 타워에서 리아나라는 소녀를 만나며 운명이 급격히 바뀌게 됩니다...\n이 게임은 1993년에 전작의 후속작으로 발매되었습니다. 전작의 주인공 카엘이 이번 작품에서도 등장하여 박진감 넘치는 이야기를 펼칩니다.\n한 번 시작하면 멈출 수 없을 것입니다."
 },
