  "old_text": "Fate",
  "new_text": "페이트"
 },
 {
  "offset": 16514,
  "old_encoding": "ascii",
  "old_length_field": 6,
  "old_text": "Sion!",
  "new_text": "시온!"
 },
 {
  "offset": 16558,
  "old_encoding": "ascii",
  "old_length_field": 6,
  "old_text": "Lanzo",
  "new_text": "란조"
 },
 {
  "offset": 16618,
  "old_encoding": "ascii",
  "old_length_field": 41,
  "old_text": "Today's the day you become a man, right?",
  "new_text": "오늘부터 너도 어른들의 동료가 되는 거네? 그치?"
 },
 {
  "offset": 16701,
  "old_encoding": "ascii",
  "old_length_field": 6,
  "old_text": "Dewey",
  "new_text": "듀이"
 },
 {
  "offset": 16759,
  "old_encoding": "ascii",
  "old_length_field": 45,
  "old_text": "Honestly, you always just barge into things!",
  "new_text": "정말 당신이라는 사람은, 행동이 너무 빠르다니까요!"
 },
 {
  "offset": 16842,
  "old_encoding": "ascii",
  "old_length_field": 6,
  "old_text": "Tiara",
  "new_text": "티아라"
 },
 {
  "offset": 16884,
  "old_encoding": "ascii",
  "old_length_field": 16,
  "old_text": "Congrats, Fate!",
  "new_text": "축하해요! 페이트 씨!"
 },
 {
  "offset": 16936,
  "old_encoding": "ascii",
  "old_length_field": 5,
  "old_text": "Alef",
  "new_text": "알레프"
 },
 {
  "offset": 16985,
  "old_encoding": "ascii",
  "old_length_field": 30,
  "old_text": "Heh! Not too shabby, brother!",
  "new_text": "훗! 제법인데, 페이트 형!"
 },
 {
  "offset": 17057,
  "old_encoding": "ascii",
  "old_length_field": 5,
  "old_text": "Fate",
  "new_text": "페이트"
 },
 {
  "offset": 17090,
  "old_encoding": "ascii",
  "old_length_field": 18,
  "old_text": "Thanks, everyone.",
  "new_text": "고마워... 모두들."
 },
 {
  "offset": 17144,
  "old_encoding": "ascii",
  "old_length_field": 5,
  "old_text": "Alef",
  "new_text": "알레프"
 },
 {
  "offset": 17205,
  "old_encoding": "ascii",
  "old_length_field": 44,
  "old_text": "Your bride is waiting for ya! Hurry on off!",
  "new_text": "신부님이 기다리고 계신다고! 얼른 가봐!"
 },
 {
  "offset": 17291,
  "old_encoding": "ascii",
  "old_length_field": 6,
  "old_text": "Tiara",
  "new_text": "티아라"
 },
 {
  "offset": 17365,
  "old_encoding": "ascii",
  "old_length_field": 74,
  "old_text": "He's right! No good will come of keeping a bride pretty as \nthat waiting.",
  "new_text": "맞아! 저렇게 귀여운 신부를 기다리게 하면\n천벌을 받을걸?"
 },
 {
  "offset": 17477,
  "old_encoding": "ascii",
  "old_length_field": 5,
  "old_text": "Fate",
  "new_text": "페이트"
 },
 {
  "offset": 17508,
  "old_encoding": "ascii",
  "old_length_field": 33,
  "old_text": "Um... Sorry to keep you waiting.",
  "new_text": "저기... 많이 기다렸지?"
 },
 {
  "offset": 17583,
  "old_encoding": "ascii",
  "old_length_field": 6,
  "old_text": "Liana",
  "new_text": "리아나"
 },
 {
  "offset": 17625,
  "old_encoding": "ascii",
  "old_length_field": 16,
  "old_text": "Oh, not at all!",
  "new_text": "아니! 전혀 아니야!"
 },
 {
  "offset": 17677,
  "old_encoding": "ascii",
  "old_length_field": 4,
  "old_text": "Gia",
  "new_text": "지아"
 },
 {
  "offset": 17719,
  "old_encoding": "ascii",
  "old_length_field": 23,
  "old_text": "Safe travels, you two.",
  "new_text": "조심해서 다녀오라고?"
 },
 {
  "offset": 17784,
  "old_encoding": "ascii",
  "old_length_field": 5,
  "old_text": "Fate",
  "new_text": "페이트"
 },
 {
  "offset": 17817,
  "old_encoding": "ascii",
  "old_length_field": 23,
  "old_text": "Thanks. We'll be back.",
  "new_text": "응... 다녀올게."
 },
