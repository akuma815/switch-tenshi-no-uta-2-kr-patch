  "old_encoding": "ascii",
  "old_length_field": 5,
  "old_text": "Hhf!",
  "new_text": "핫!"
 },
 {
  "offset": 17950,
  "old_encoding": "ascii",
  "old_length_field": 6,
  "old_text": "Liana",
  "new_text": "리아나"
 },
 {
  "offset": 17986,
  "old_encoding": "ascii",
  "old_length_field": 20,
  "old_text": "What's wrong, Fate?",
