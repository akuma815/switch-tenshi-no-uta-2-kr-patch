 {
  "offset": 18048,
  "old_encoding": "ascii",
  "old_length_field": 5,
  "old_text": "Fate",
  "new_text": "페이트"
 },
 {
  "offset": 18079,
  "old_encoding": "ascii",
  "old_length_field": 18,
  "old_text": "No, it's nothing.",
