[
 {
  "offset": 48,
  "old_encoding": "ascii",
  "old_length_field": 5,
  "old_text": "Fate",
  "new_text": "페이트"
 },
 {
  "offset": 117,
  "old_encoding": "ascii",
  "old_length_field": 64,
  "old_text": "Good to see you've come to.\nThe name's Fate. What do you go by?",
  "new_text": "다행이야, 정신이 들었구나.\n내 이름은 페이트, 너는?"
 },
