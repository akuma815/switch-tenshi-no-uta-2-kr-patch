[
 {
  "file": "L10N/en/Ogix/Data/DT/Common/DT_BootView.uexp",
  "offset": 29,
  "old_encoding": "utf16",
  "old_length_field": -4,
  "old_text": "ご注意",
  "new_text": "주의사항"
 },
 {
  "file": "L10N/en/Ogix/Data/DT/Common/DT_BootView.uexp",
  "offset": 41,
  "old_encoding": "utf16",
  "old_length_field": -116,
  "old_text": "ゲームソフトを権利者の許諾なく、\\nインターネットを通じて配信、配布する行為、\\nまた、違法なインターネット配信と知りながら、\\nダウンロードする行為は法律で固く禁じられております。\\nみなさまのご理解とご協力をお願いいたします。",
  "new_text": "게임 소프트웨어를 권리자의 허락 없이\\n인터넷을 통해 배포, 유포하는 행위,\\n또한 불법 인터넷 배포임을 알면서도\\n다운로드하는 행위는 법으로 엄격히 금지되어 있습니다.\\n여러분의 이해와 협조를 부탁드립니다."
 },
 {
  "file": "L10N/en/Ogix/Data/DT/Game_2/DT_Game2_GameInfo.uexp",
